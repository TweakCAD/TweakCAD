{
  "name": "@tweakcad/cad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TweakCAD editor — the browser CAD app and the libraries only it uses (format, editor, kernel, viewport, worker, fcstd-import, f3d-import, api-client, cloud-providers) folded into one project. cad-tools is the canonical CAD tool catalogue; api-types is a client-safe subset of the server API contract. Both resolve via lib/ paths, not deps.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ lib/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\"",
    "test:unit": "vitest run"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@salusoft89/planegcs": "1.3.0",
    "comlink": "4.4.2",
    "fflate": "0.8.3",
    "fzstd": "0.1.1",
    "immer": "11.2.9",
    "lucide-react": "1.61.0",
    "occt-wasm": "npm:@tweakcad/occt-wasm@5.17.0-tweakcad.4",
    "opentype.js": "2.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5",
    "vite-plugin-top-level-await": "1.6.0",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
